<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cczj.urlservice.mapper.sys.SysDeptMapper">

    <select id="selectHasChild" resultType="java.lang.Integer">
        select 1
        from sys_dept sd
        where sd.deleted = 0
          and sd.status = 1
          and find_in_set(#{deptId}, sd.ancestors)
        limit 1
    </select>
</mapper>
