<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cczj.urlservice.mapper.sys.OpenAccountMapper">



    <select id="getOpenAccountPage" resultType="com.cczj.common.bean.vo.sys.OpenAccountPageVO">
        select *
        from open_account oa
        where oa.deleted = 0
        <if test="params.appId!=null and params.appId!=''">
            and oa.app_id = #{params.appId}
        </if>
        <if test="params.status!=null">
            and oa.status = #{params.status}
        </if>
        order by oa.id desc
    </select>
</mapper>
